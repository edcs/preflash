# Settings both boards share. sdkconfig.defaults.4b and sdkconfig.defaults.349 pick the board.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Log lines only get in the way of the JSON, and colour codes would land inside it.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_COLORS=n
